# Fins de ligne en LF, y compris dans la copie de travail sous Windows :
# évite les avertissements « LF will be replaced by CRLF » à chaque git add.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.7z binary
*.rar binary
*.exe binary
*.dll binary
*.node binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp3 binary
*.mp4 binary
*.wav binary
